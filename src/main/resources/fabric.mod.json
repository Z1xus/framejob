{
  "schemaVersion": 1,
  "id": "framejob",
  "name": "Framejob",
  "version": "${version}",
  "environment": "client",
  "description": "Smooths swings, block-hits, FOV, hand sway and the sneak camera between ticks for high FPS recordings",
  "authors": ["Z1xus"],
  "contact": {
    "issues": "https://github.com/Z1xus/framejob/issues",
    "sources": "https://github.com/Z1xus/framejob"
  },
  "license": "MIT",
  "icon": "assets/framejob/icon.png",
  "entrypoints": {
    "client": ["us.z1x.framejob.Framejob::load"],
    "oneconfig:config": ["us.z1x.framejob.FramejobConfig::register"]
  },
  "mixins": ["mixins.framejob.json", "mixins.framejob.optional.json"],
  "depends": {
    "minecraft": "${minecraft}",
    "fabricloader": ">=${loader}",
    "java": ">=${java}"
  }
}
