{
  "schemaVersion": 1,
  "id": "framejob",
  "name": "Framejob",
  "version": "${version}",
  "environment": "client",
  "description": "Smooth swings, FOV and hand sway that look good on recordings",
  "authors": ["Z1xus"],
  "contact": {
    "issues": "https://github.com/Z1xus/framejob/issues",
    "sources": "https://github.com/Z1xus/framejob"
  },
  "license": "MIT",
  "entrypoints": {
    "client": ["us.z1x.framejob.Framejob::load"],
    "oneconfig:config": ["us.z1x.framejob.FramejobConfig::register"]
  },
  "mixins": ["mixins.framejob.json"],
  "depends": {
    "minecraft": "${minecraft}",
    "fabricloader": ">=${loader}",
    "java": ">=${java}"
  }
}
